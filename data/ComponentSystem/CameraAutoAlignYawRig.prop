<?xml version="1.0" encoding="utf-8"?>
<property version="2.21.0.0" name="CameraAutoAlignYawRig" manual="1" parent_name="node_base">
	<parameter name="stage" type="switch" items="Intent,Rig,Constraints,Presentation,Finalize,">1</parameter>
	<parameter name="priority" type="int">0</parameter>
	<parameter name="used_in_pipeline" type="toggle">1</parameter>
	<parameter name="input_deadzone" type="float">0.05</parameter>
	<parameter name="delay" type="float">3</parameter>
	<parameter name="speed" type="float">10</parameter>
	<parameter name="max_deg_per_sec" type="float">180</parameter>
	<parameter name="rate_acceleration" type="float" tooltip="Скорость нарастания углового лимита авто-поворота (deg/s^2). 360 — выход на max_deg_per_sec за ~0.5с при max=180. Меньше — мягче старт, меньше дёргает направление движения, завязанное на камеру">360</parameter>
	<parameter name="rate_acceleration_exponential" type="toggle" tooltip="Если включено, лимит нарастает экспоненциально: r += (max - r) * (1 - exp(-k*dt)), где k = rate_acceleration / max. Иначе — линейно (r += rate_acceleration * dt)">0</parameter>
	<parameter name="yaw_offset_deg" type="float">0</parameter>
	<parameter name="vel_dir_smooth" type="float">12</parameter>
	<parameter name="target_yaw_smooth" type="float">10</parameter>
	<parameter name="reset_timer_on_stop" type="toggle">1</parameter>
	<parameter name="min_target_velocity" type="float">2</parameter>
</property>
