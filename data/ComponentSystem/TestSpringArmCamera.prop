<?xml version="1.0" encoding="utf-8"?>
<property version="2.22.0.0" name="TestSpringArmCamera" manual="1" parent_name="node_base" editable="0">
	<parameter name="target" type="node" group="Spring Arm">0</parameter>
	<parameter name="target_offset" type="vec3" title="Target Offset" tooltip="Target-local pivot offset" group="Spring Arm">0.000000 0.000000 0.000000</parameter>
	<parameter name="arm_length" type="float" title="Arm Length" tooltip="Distance from the pivot to the camera" group="Spring Arm">4</parameter>
	<parameter name="mouse_sensitivity" type="float" title="Mouse Sensitivity" tooltip="Degrees per raw mouse count" group="Rotation">0.1</parameter>
	<parameter name="min_pitch" type="float" title="Min Pitch" tooltip="Minimum arm pitch in degrees" group="Rotation">-60</parameter>
	<parameter name="max_pitch" type="float" title="Max Pitch" tooltip="Maximum arm pitch in degrees" group="Rotation">75</parameter>
	<parameter name="invert_pitch" type="toggle" title="Invert Pitch" tooltip="Invert vertical mouse input" group="Rotation">0</parameter>
	<parameter name="enable_min_angle_bias" type="toggle" title="Enable Min Angle Bias" tooltip="Blend the camera view upward near the minimum pitch" group="Vertical Camera Bias">0</parameter>
	<parameter name="min_angle_bias_offset" type="float" title="Min Angle Bias Offset" tooltip="Degrees above Min Pitch over which the view blends toward world up. Zero disables the bias. Independent of arm length and collision." group="Vertical Camera Bias">0</parameter>
	<parameter name="enable_position_lag" type="toggle" title="Enable Position Lag" tooltip="Smooth the spring arm pivot as it follows the target" group="Camera Lag">1</parameter>
	<parameter name="position_lag_time_95" type="float" title="Horizontal Follow Time (s)" tooltip="Seconds to remove 95% of a fixed horizontal pivot error. Larger values increase trailing distance. Zero follows immediately." group="Camera Lag">0.3</parameter>
	<parameter name="position_lag_max_distance" type="float" title="Max Pivot Lag (m)" tooltip="Hard total-distance limit on pivot lag. Zero disables positional lag. This safety cap can override response times." group="Advanced">3</parameter>
	<parameter name="position_lag_vertical_time_95" type="float" title="Vertical Follow Time (s)" tooltip="Seconds to remove 95% of a fixed vertical pivot error. Zero follows height immediately. Independent of horizontal follow." group="Camera Lag">0.3</parameter>
	<parameter name="enable_rotation_lag" type="toggle" title="Enable Rotation Lag" tooltip="Enable spring-like lag for camera yaw and pitch" group="Camera Lag">1</parameter>
	<parameter name="rotation_lag_time_95" type="float" title="Rotation Response Time (s)" tooltip="Seconds to remove 95% of a fixed angular error from rest. Larger values soften manual rotation. Zero follows immediately. Automatic axes use their own response." group="Camera Lag">0.2965</parameter>
	<parameter name="enable_auto_rotation" type="toggle" title="Enable Auto Rotation" tooltip="Align camera yaw with the target movement direction" group="Auto Rotation">1</parameter>
	<parameter name="auto_rotation_time_95" type="float" title="Response Time (s)" tooltip="Seconds to remove 95% of a fixed yaw error from rest, without the advanced speed limit. Smooth acceleration is built in. Zero responds immediately subject to the speed limit." group="Auto Rotation">0.6</parameter>
	<parameter name="auto_rotation_max_speed" type="float" title="Max Rotation Speed" tooltip="Maximum automatic yaw speed in degrees per second" group="Advanced">180</parameter>
	<parameter name="auto_rotation_min_move_speed" type="float" title="Min Move Speed" tooltip="Minimum horizontal target speed in meters per second" group="Advanced">1.5</parameter>
	<parameter name="auto_rotation_resume_delay" type="float" title="Resume Delay" tooltip="Seconds after the last manual camera input before auto yaw is allowed. Countdown continues while standing. Zero allows immediate activation." group="Auto Rotation">1</parameter>
	<parameter name="enable_camera_recovery" type="toggle" title="Enable Camera Recovery" tooltip="Recover pitch toward the configured comfort range while moving" group="Camera Recovery">1</parameter>
	<parameter name="camera_recovery_time_95" type="float" title="Response Time (s)" tooltip="Seconds to remove 95% of a fixed pitch error from rest, without the advanced speed limit. Smooth acceleration is built in. Zero responds immediately subject to the speed limit." group="Camera Recovery">1</parameter>
	<parameter name="camera_recovery_max_speed" type="float" title="Max Recovery Speed" tooltip="Maximum automatic pitch speed in degrees per second" group="Advanced">180</parameter>
	<parameter name="camera_recovery_activation_delay" type="float" title="Activation Delay" tooltip="Seconds of movement required after manual pitch input before recovery starts. Countdown pauses while standing. Zero allows immediate activation." group="Camera Recovery">0.5</parameter>
	<parameter name="camera_recovery_min_move_speed" type="float" title="Min Move Speed" tooltip="Minimum horizontal target speed in meters per second" group="Advanced">1.5</parameter>
	<parameter name="camera_recovery_target_pitch_min" type="float" title="Target Pitch Min" tooltip="Lower boundary of the comfortable pitch range" group="Camera Recovery">-20</parameter>
	<parameter name="camera_recovery_target_pitch_max" type="float" title="Target Pitch Max" tooltip="Upper boundary of the comfortable pitch range" group="Camera Recovery">30</parameter>
	<parameter name="enable_camera_collision" type="toggle" title="Enable Camera Collision" tooltip="Prevent the camera from passing through scene geometry" group="Collision">1</parameter>
	<parameter name="collision_sphere_radius" type="float" title="Collision Sphere Radius" tooltip="Camera collision clearance radius" group="Collision">0.3</parameter>
	<parameter name="camera_collision_mask" type="mask" title="Camera Collision Mask" tooltip="Surface collision and intersection mask used by the camera" group="Collision">1</parameter>
	<parameter name="enable_smooth_collision_return" type="toggle" title="Enable Smooth Return" tooltip="Smoothly restore the spring arm distance after collision" group="Smooth Zoom After Collision">1</parameter>
	<parameter name="collision_return_time_95" type="float" title="Return Time (s)" tooltip="Seconds to recover 95% of a fixed available arm distance from rest, after Return Delay. Smooth start and finish. Zero returns immediately; inward collision correction is always immediate." group="Smooth Zoom After Collision">0.6</parameter>
	<parameter name="collision_return_delay" type="float" title="Return Delay" tooltip="Seconds to wait after an inward collision correction before extending toward the currently safe distance. Zero removes the wait." group="Smooth Zoom After Collision">0.2</parameter>
</property>
