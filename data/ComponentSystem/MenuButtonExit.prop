		<parameter name="offset" type="vec3" group="Hover">0.000000 0.000000 0.000000</parameter>
		<parameter name="speed" type="float" title="Speed" tooltip="Approach rate toward open pose" group="Hover">8</parameter>
		<parameter name="damping" type="float" title="Damping" tooltip="Return rate to rest pose" group="Hover">8</parameter>
	</struct>
	<parameter name="hoverSound" type="string" title="Hover Sound" group="Hover"/>
