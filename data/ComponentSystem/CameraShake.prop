<?xml version="1.0" encoding="utf-8"?>
<property version="2.21.0.0" name="CameraShake" manual="1" parent_name="node_base">
	<parameter name="stage" type="switch" items="Intent,Rig,Constraints,Presentation,Finalize,">1</parameter>
	<parameter name="priority" type="int">0</parameter>
	<parameter name="used_in_pipeline" type="toggle">1</parameter>
	<parameter name="maxOffset" type="float" title="Max Offset" tooltip="Maximum positional shake (m) at trauma=1.0">0.15</parameter>
	<parameter name="maxRotDeg" type="float" title="Max Rotation" tooltip="Maximum angular roll (degrees) at trauma=1.0">2</parameter>
	<parameter name="recoveryPerSecond" type="float" title="Recovery" tooltip="Trauma decay rate. 1.0 = full→empty in 1 second; bigger = snappier">1.6</parameter>
	<parameter name="frequency" type="float" title="Frequency" tooltip="Oscillation rate (Hz). 20-30 looks &apos;kick&apos;-y, 8-12 looks &apos;rumble&apos;-y">25</parameter>
</property>
