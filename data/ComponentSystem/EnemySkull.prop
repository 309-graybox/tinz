<?xml version="1.0" encoding="utf-8"?>
<property version="2.21.0.0" name="EnemySkull" manual="1" parent_name="node_base">
	<struct name="MaterialFloat4ParamInfo">
		<parameter name="apply_to_target" type="toggle">0</parameter>
		<parameter name="target" type="node" apply_to_target="1">0</parameter>
		<parameter name="surface" type="int">0</parameter>
		<parameter name="param" type="string"/>
		<parameter name="death_value" type="vec4">1.000000 1.000000 1.000000 1.000000</parameter>
	</struct>
	<parameter name="has_hp" type="toggle">0</parameter>
	<parameter name="max_hp" type="float">0</parameter>
	<parameter name="teamId" type="int" tooltip="Team identifier used by Hitbox to skip same-team targets (friendly fire prevention). 0 = player, 1 = enemy by convention.">0</parameter>
	<parameter name="invulnerabilityTime" type="float" tooltip="Damage immunity duration in seconds after taking damage. 0 = disabled">0</parameter>
	<parameter name="persistOnDeath" type="toggle" tooltip="If true, the node is NOT auto-deleted on death — owner reacts via eventDied (used by the player so respawn can revive it)">0</parameter>
	<parameter name="deleteTimer" type="float">0</parameter>
	<parameter name="soundOnDamage" type="string" title="Damage Sound" tooltip="SoundManager event id or direct audio path"/>
	<parameter name="damageShake" type="float" tooltip="Camera trauma added when this entity is the player and receives damage">0.7</parameter>
	<parameter name="enable_on_death" type="array" array_type="node"/>
	<parameter name="disable_on_death" type="array" array_type="node"/>
	<parameter name="mat_float4_params" type="array" array_type="MaterialFloat4ParamInfo"/>
	<parameter name="behavior" type="switch" title="Skull behavior" items="Direct,Orbit,Flank">0</parameter>
	<parameter name="sightRange" type="float" tooltip="Maximum free line-of-sight length at which the skull notices the player" group="Sight">20</parameter>
	<parameter name="sightMask" type="mask" tooltip="Intersection mask for the line-of-sight raycast" group="Sight">-1</parameter>
	<parameter name="memoryDuration" type="float" tooltip="After losing line of sight, the skull keeps tracking the player for this many seconds before going idle" group="Sight">3</parameter>
	<parameter name="speed" type="float" tooltip="Target chase speed" group="Movement">8</parameter>
	<parameter name="accel" type="float" tooltip="Maximum velocity change per second — smooths jerks and reactions to collisions" group="Movement">60</parameter>
	<parameter name="linearDamping" type="float" tooltip="Linear damping applied to BodyRigid on init. 0 is fine since velocity is overwritten every frame" group="Movement">0</parameter>
	<parameter name="verticalSpeedFactor" type="float" tooltip="Multiplier on the vertical (Z) component of the desired velocity. Keeps skulls reachable for a stomp-kill — they can&apos;t dart up out of the player&apos;s jump arc" group="Movement">0.3</parameter>
	<parameter name="orbitDistance" type="float" tooltip="Below this distance the blue skull abandons the orbit and rams the player directly" group="Orbit">1.5</parameter>
	<parameter name="orbitApproachSpeed" type="float" tooltip="Constant inward pull applied while orbiting (m/s) — controls how fast the spiral tightens" group="Orbit">2</parameter>
	<parameter name="flankDistance" type="float" tooltip="Radius the green skull holds while orbiting around the player toward their back" group="Flank">3</parameter>
	<parameter name="flankCommitAngle" type="float" tooltip="Once the skull is within this angle (degrees) of the player&apos;s back, it commits to a straight ram" group="Flank">30</parameter>
	<parameter name="flankRadialCorrection" type="float" tooltip="How aggressively (m/s) the skull corrects toward `flankDistance` while orbiting" group="Flank">2</parameter>
	<parameter name="hitboxNode" type="node" group="Child node carrying the Hitbox component that damages the player on contact. Damage / team / shape are configured on the Hitbox itself.">0</parameter>
	<parameter name="attackCooldown" type="float" tooltip="Minimum time between hits (only meaningful when dieOnHit is off). Hitbox is deactivated for this duration after each successful hit, then re-armed." group="Attack">1</parameter>
	<parameter name="dieOnHit" type="toggle" tooltip="Skull is destroyed immediately after dealing damage (kamikaze)" group="Attack">1</parameter>
</property>
