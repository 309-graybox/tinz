<?xml version="1.0" encoding="utf-8"?>
<property version="2.20.0.0" name="PlayerCamera" manual="1" parent_name="node_base">
	<struct name="Cfg">
		<parameter name="sensitivity" type="vec2">0.200000 0.200000</parameter>
		<parameter name="inverse_x" type="toggle">0</parameter>
		<parameter name="inverse_y" type="toggle">0</parameter>
		<parameter name="distance_range" type="dvec2">2.000000 5.000000</parameter>
		<parameter name="pitch_range" type="vec2">-89.900002 89.900002</parameter>
	</struct>
	<struct name="CameraCollision">
		<parameter name="radius" type="double">0.3</parameter>
		<parameter name="offset" type="double">0.01</parameter>
		<parameter name="mask" type="mask">-1</parameter>
	</struct>
	<struct name="CameraSpringArm">
		<parameter name="return_speed" type="float">5</parameter>
		<parameter name="return_delay" type="float">0.2</parameter>
		<parameter name="max_correction_distance" type="float">3</parameter>
		<parameter name="use_adaptive_speed" type="toggle">1</parameter>
		<parameter name="damping" type="double">0.8</parameter>
	</struct>
	<struct name="CameraPositionLag">
		<parameter name="separate_axis" type="toggle">0</parameter>
		<parameter name="speed" type="double" separate_axis="0">1</parameter>
		<parameter name="damping" type="double" separate_axis="0">1</parameter>
		<parameter name="max_distance" type="double" separate_axis="0">300</parameter>
		<parameter name="speed_axis" type="dvec3" separate_axis="1">1.000000 1.000000 1.000000</parameter>
		<parameter name="damping_axis" type="dvec3" separate_axis="1">1.000000 1.000000 1.000000</parameter>
		<parameter name="max_distance_axis" type="dvec3" separate_axis="1">300.000000 300.000000 300.000000</parameter>
	</struct>
	<struct name="CameraRotationLag">
		<parameter name="separate_axis" type="toggle">0</parameter>
		<parameter name="speed" type="float" separate_axis="0">20</parameter>
		<parameter name="speed_axis" type="vec2" separate_axis="1">20.000000 20.000000</parameter>
	</struct>
	<parameter name="debug" type="toggle">1</parameter>
	<parameter name="target_node" type="node">0</parameter>
	<parameter name="cfg" type="Cfg"/>
	<parameter name="collision_enabled" type="toggle">1</parameter>
	<parameter name="collision" type="CameraCollision"/>
	<parameter name="spring_arm_enabled" type="toggle">1</parameter>
	<parameter name="spring_arm" type="CameraSpringArm"/>
	<parameter name="position_lag_enabled" type="toggle">1</parameter>
	<parameter name="position_lag" type="CameraPositionLag"/>
	<parameter name="rotation_lag_enabled" type="toggle">1</parameter>
	<parameter name="rotation_lag" type="CameraRotationLag"/>
</property>
