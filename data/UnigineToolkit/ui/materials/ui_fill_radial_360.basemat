BaseMaterial <preview_hidden=true var_prefix=var texture_prefix=tex>
{
	Texture color = "white.texture" <anisotropy=true, hidden=true>
	State origin = 0 <items = [Bottom Right Top Left]>
	State clockwise = 1
	Slider amount = 0.8

	Shader shader = 
	#{

#define VERTEX_ATTRIBUTE_POST
#include <core/materials/shaders/render/common.h>

STRUCT(FRAGMENT_IN)
	INIT_POSITION
	INIT_DATA(float2, 0, DATA_UV0)
	INIT_DATA(float4, 1, DATA_VERTEX_COLOR)
END

#ifdef VERTEX

	MAIN_BEGIN(FRAGMENT_IN, VERTEX_IN)
		
		float4 row_0 = s_transform[0];
		float4 row_1 = s_transform[1];
		float4 row_2 = s_transform[2];
		
		float4 vertex = float4(
			dot(ATTRIBUTE_POSITION, row_0),
			dot(ATTRIBUTE_POSITION, row_1),
			dot(ATTRIBUTE_POSITION, row_2),
			1.0f
		);

		OUT_POSITION = mul4(s_projection, vertex);
		DATA_UV0 = ATTRIBUTE_UV.xy;
		DATA_VERTEX_COLOR = ATTRIBUTE_COLOR;
	
	MAIN_END
		
#elif FRAGMENT

	INIT_TEXTURE(0, TEX_COLOR)

	STRUCT_FRAG_BEGIN
		INIT_COLOR(float4)
	STRUCT_FRAG_END
	
	float normalizeAngle(float deg)
	{
		return fmod(fmod(deg, 360.0) + 360.0, 360.0);
	}

	bool isAngleBetween(float angle, float from, float to)
	{
#ifdef STATE_CLOCKWISE
		if (from < to)
#else
		if (from <= to)
#endif
			return angle >= from && angle <= to;
		else
			return angle >= from || angle <= to;
	}	

	MAIN_FRAG_BEGIN(FRAGMENT_IN)

	if (var_amount <= 0)
		discard;

    float2 uv = DATA_UV0;
    float2 center = float2(0.5, 0.5);
	float2 texel_centered = (uv - center);
	
    float angle = degrees(atan2(texel_centered.y, texel_centered.x));
    angle = normalizeAngle(angle);

#ifdef STATE_CLOCKWISE
	#ifdef STATE_ORIGIN_BOTTOM
		float a_from = normalizeAngle(90);
		float a_to = normalizeAngle(360 * var_amount + 90);
	#elif STATE_ORIGIN_RIGHT
		float a_from = normalizeAngle(0);
		float a_to = normalizeAngle(360 * var_amount);
	#elif STATE_ORIGIN_TOP
		float a_from = normalizeAngle(270);
		float a_to = normalizeAngle(360 * var_amount + 270);
	#elif STATE_ORIGIN_LEFT
		float a_from = normalizeAngle(180);
		float a_to = normalizeAngle(360 * var_amount + 180);
	#endif

    if (!isAngleBetween(angle, a_from, a_to))
        discard;
#else
	#ifdef STATE_ORIGIN_BOTTOM
		float a_from = normalizeAngle(90);
		float a_to = normalizeAngle(90 - 360 * var_amount);
	#elif STATE_ORIGIN_RIGHT
		float a_from = normalizeAngle(0);
		float a_to = normalizeAngle(0 - 360 * var_amount);
	#elif STATE_ORIGIN_TOP
		float a_from = normalizeAngle(270);
		float a_to = normalizeAngle(270 - 360 * var_amount);
	#elif STATE_ORIGIN_LEFT
		float a_from = normalizeAngle(180);
		float a_to = normalizeAngle(180 - 360 * var_amount);
	#endif

    if (isAngleBetween(angle, a_from, a_to))
        discard;
#endif

	float4 color = TEXTURE(tex_color, uv);
	OUT_COLOR = color * DATA_VERTEX_COLOR;

	MAIN_FRAG_END 
#endif

	#}

	Pass post
	{
		Fragment = shader
		Vertex = shader
	}
}