BaseMaterial <preview_hidden=1 var_prefix=var texture_prefix=tex>
{
	Texture color = "white.texture" <anisotropy=true, hidden=true>
	Texture src_color <source=procedural internal=true>
	Texture2DArray noise="core/textures/common/noise.texture" <internal=true>
	
	Group "Blur 2D"
	{
		Float radius = 3.0
		Slider jitter = 0.0
	}
	
	Int4 padding = [16 16 16 16]
	Float4 stops <hidden=true>
	Float4 offsets <hidden=true>
	Float4 scale <hidden=true>
	
	// this variables automatically fills by UI elements
	Int2 texture_size <hidden=true>
	Int2 sprite_pos <hidden=true>
	Int2 sprite_size <hidden=true>
	Int2 screen_size <hidden=true>
	
	////////////////////////////////////////////////////
	// blur
	////////////////////////////////////////////////////
	
	Shader render_blur_2d_frag=
	#{
		#include <core/materials/shaders/render/common.h>
		
		STRUCT_FRAG_BEGIN
			INIT_COLOR(float4)
		STRUCT_FRAG_END
		
		MAIN_FRAG_BEGIN(FRAGMENT_IN)
			#ifdef HORIZONTAL
				float2 uv_offset = float2(s_viewport.z, 0.0f);
			#else
				float2 uv_offset = float2(0.0f, s_viewport.w);
			#endif
			
			float4 noise = TEXTURE_ARRAY_FETCH(tex_noise, fmod(IN_POSITION.xy, 256), uint(s_frame) % 8 * uint(s_taa));
			uv_offset *= lerp(1.0f, noise.x * 2.0f, var_jitter);
			
			OUT_COLOR.a = 1.0f;
			OUT_COLOR.rgb =	TEXTURE_BIAS_ZERO(tex_src_color, IN_UV).xyz * 0.142300f +
							
							TEXTURE_BIAS_ZERO(tex_src_color, IN_UV + uv_offset * 1 * var_radius).xyz * 0.134610f +
							TEXTURE_BIAS_ZERO(tex_src_color, IN_UV + uv_offset * 2 * var_radius).xyz * 0.113945f +
							TEXTURE_BIAS_ZERO(tex_src_color, IN_UV + uv_offset * 3 * var_radius).xyz * 0.086310f +
							TEXTURE_BIAS_ZERO(tex_src_color, IN_UV + uv_offset * 4 * var_radius).xyz * 0.058501f +
							TEXTURE_BIAS_ZERO(tex_src_color, IN_UV + uv_offset * 5 * var_radius).xyz * 0.035483f +
							
							TEXTURE_BIAS_ZERO(tex_src_color, IN_UV - uv_offset * 1 * var_radius).xyz * 0.134610f +
							TEXTURE_BIAS_ZERO(tex_src_color, IN_UV - uv_offset * 2 * var_radius).xyz * 0.113945f +
							TEXTURE_BIAS_ZERO(tex_src_color, IN_UV - uv_offset * 3 * var_radius).xyz * 0.086310f +
							TEXTURE_BIAS_ZERO(tex_src_color, IN_UV - uv_offset * 4 * var_radius).xyz * 0.058501f +
							TEXTURE_BIAS_ZERO(tex_src_color, IN_UV - uv_offset * 5 * var_radius).xyz * 0.035483f;
		MAIN_FRAG_END
	#}
	
	Pass render_blur_2d_horizontal <defines="HORIZONTAL">
	{
		Fragment=render_blur_2d_frag
	}
	
	Pass render_blur_2d_vertical
	{
		Fragment=render_blur_2d_frag
	}
	
	Expression RENDER_CALLBACK_END_POST_MATERIALS = 
	#{
		Texture source = engine.render.getTemporaryTexture(engine.render_state.getScreenColorTexture());
		Texture dest = engine.render.getTemporaryTexture(engine.render_state.getScreenColorTexture());
		
		source.copy(engine.render_state.getScreenColorTexture());
		
		setTexture("src_color", source);
		renderPassToTexture("render_blur_2d_horizontal", dest);
		
		setTexture("src_color", dest);
		renderPassToTexture("render_blur_2d_vertical", source);
		
		setTexture("src_color", source);
		
		engine.render.releaseTemporaryTexture(source);
		engine.render.releaseTemporaryTexture(dest);
	#}
	
	////////////////////////////////////////////////////
	// update
	////////////////////////////////////////////////////
	
	Shader shader = 
	#{

#define VERTEX_ATTRIBUTE_POST
#include <core/materials/shaders/render/common.h>

STRUCT(FRAGMENT_IN)
	INIT_POSITION
	INIT_DATA(float2, 0, DATA_UV0)
	INIT_DATA(float4, 1, DATA_VERTEX_COLOR)
END

#ifdef VERTEX

	MAIN_BEGIN(FRAGMENT_IN, VERTEX_IN)
		
		float4 row_0 = s_transform[0];
		float4 row_1 = s_transform[1];
		float4 row_2 = s_transform[2];
		
		float4 vertex = float4(
			dot(ATTRIBUTE_POSITION, row_0),
			dot(ATTRIBUTE_POSITION, row_1),
			dot(ATTRIBUTE_POSITION, row_2),
			1.0f
		);

		OUT_POSITION = mul4(s_projection, vertex);
		DATA_UV0 = ATTRIBUTE_UV.xy;
		DATA_VERTEX_COLOR = ATTRIBUTE_COLOR;
	
	MAIN_END
		
#elif FRAGMENT

	INIT_TEXTURE(0, TEX_COLOR)
	INIT_TEXTURE(1, TEX_SRC_COLOR)

	STRUCT_FRAG_BEGIN
		INIT_COLOR(float4)
	STRUCT_FRAG_END

	MAIN_FRAG_BEGIN(FRAGMENT_IN)

	// get color texel
	float2 uv = DATA_UV0;

	float s0, s1, s2;
	s0 =            step(uv.x, var_stops.x);
	s1 = (1 - s0) * step(uv.x, var_stops.z);
	s2 = (1 - s0) * (1 - s1);
	uv.x = s0 *   uv.x                * var_scale.x
		   + s1 * ((uv.x - var_stops.x) * var_scale.z + var_offsets.x)
		   + s2 * ((uv.x - var_stops.z) * var_scale.x + var_offsets.z);

	s0 =            step(uv.y, var_stops.y);
	s1 = (1 - s0) * step(uv.y, var_stops.w);
	s2 = (1 - s0) * (1 - s1);
	uv.y = s0 *   uv.y                * var_scale.y
		   + s1 * ((uv.y - var_stops.y) * var_scale.w + var_offsets.y)
		   + s2 * ((uv.y - var_stops.w) * var_scale.y + var_offsets.w);

	float4 color = TEXTURE_BIAS_ZERO(tex_color, uv) * DATA_VERTEX_COLOR;

	// get blur texel
	float2 widget_pos = float2(var_sprite_pos) / float2(var_screen_size);
	float2 widget_size = float2(var_sprite_size) / float2(var_screen_size);
	float2 blur_uv = DATA_UV0 * widget_size + widget_pos;
	float4 blur_color = TEXTURE_BIAS_ZERO(tex_src_color, blur_uv);
	
	// mix
	OUT_COLOR = color * blur_color * DATA_VERTEX_COLOR;

	MAIN_FRAG_END 
#endif

	#}

	Pass post
	{
		Fragment = shader
		Vertex = shader
	}
	
	Expression update =
	#{
		int in_width;
		int in_height;

		ivec4 mat_padding = getParameter("padding");
		ivec2 mat_texture_size = getParameter("texture_size");

		// scaling image if widget smaller than source image
		if (in_width < mat_padding.x + mat_padding.z + 1)
		{
			float scale = float(mat_padding.x + mat_padding.z + 1) / in_width;
			in_width = int(float(in_width) * scale);
			in_height = int(float(in_height) * scale);
		}
		if (in_height < mat_padding.y + mat_padding.z + 1)
		{
			float scale = float(mat_padding.y + mat_padding.z + 1) / in_height;
			in_width = int(float(in_width) * scale);
			in_height = int(float(in_height) * scale);
		}

		vec4 var_stops = vec4(
			mat_padding.x / float(in_width),
			mat_padding.y / float(in_height),
			1 - mat_padding.z / float(in_width),
			1 - mat_padding.w / float(in_height)
		);
		setParameter("stops", var_stops);

		vec4 var_offsets = vec4(
			mat_padding.x / float(mat_texture_size.x),
			mat_padding.y / float(mat_texture_size.y),
			1 - mat_padding.z / float(mat_texture_size.x),
			1 - mat_padding.w / float(mat_texture_size.y)
		);
		setParameter("offsets", var_offsets);

		vec4 var_scale = vec4(
			in_width / float(mat_texture_size.x),
			in_height / float(mat_texture_size.y),
			(var_offsets.z - var_offsets.x) / (var_stops.z - var_stops.x),
			(var_offsets.w - var_offsets.y) / (var_stops.w - var_stops.y)
		);
		setParameter("scale", var_scale);
	#}	
}
