BaseMaterial <preview_hidden=true var_prefix=var texture_prefix=tex>
{
	Texture color = "white.texture" <anisotropy=true, hidden=true>
	Float sharpness = 3

	// this variables automatically fills by UI elements
	Int2 sprite_size <hidden=true>

	Shader shader = 
	#{

#define VERTEX_ATTRIBUTE_POST
#include <core/materials/shaders/render/common.h>

STRUCT(FRAGMENT_IN)
	INIT_POSITION
	INIT_DATA(float2, 0, DATA_UV0)
	INIT_DATA(float4, 1, DATA_VERTEX_COLOR)
END

#ifdef VERTEX

	MAIN_BEGIN(FRAGMENT_IN, VERTEX_IN)
		
		float4 row_0 = s_transform[0];
		float4 row_1 = s_transform[1];
		float4 row_2 = s_transform[2];
		
		float4 vertex = float4(
			dot(ATTRIBUTE_POSITION, row_0),
			dot(ATTRIBUTE_POSITION, row_1),
			dot(ATTRIBUTE_POSITION, row_2),
			1.0f
		);

		OUT_POSITION = mul4(s_projection, vertex);
		DATA_UV0 = ATTRIBUTE_UV.xy;
		DATA_VERTEX_COLOR = ATTRIBUTE_COLOR;
	
	MAIN_END
		
#elif FRAGMENT

	INIT_TEXTURE(0, TEX_COLOR)

	STRUCT_FRAG_BEGIN
		INIT_COLOR(float4)
	STRUCT_FRAG_END

	MAIN_FRAG_BEGIN(FRAGMENT_IN)

	//////////////////////////////////////////
	// use Unsharp Mask
	//////////////////////////////////////////
	
	float2 texelSize = 1.0 / var_sprite_size;

	// bilinear gaussian blur (3x3)
	float4 blur = 0.0;
	blur += TEXTURE(tex_color, DATA_UV0 + texelSize * float2(-1, -1)) * 1.0;
	blur += TEXTURE(tex_color, DATA_UV0 + texelSize * float2( 0, -1)) * 2.0;
	blur += TEXTURE(tex_color, DATA_UV0 + texelSize * float2( 1, -1)) * 1.0;

	blur += TEXTURE(tex_color, DATA_UV0 + texelSize * float2(-1,  0)) * 2.0;
	blur += TEXTURE(tex_color, DATA_UV0 + texelSize * float2( 0,  0)) * 4.0;
	blur += TEXTURE(tex_color, DATA_UV0 + texelSize * float2( 1,  0)) * 2.0;

	blur += TEXTURE(tex_color, DATA_UV0 + texelSize * float2(-1,  1)) * 1.0;
	blur += TEXTURE(tex_color, DATA_UV0 + texelSize * float2( 0,  1)) * 2.0;
	blur += TEXTURE(tex_color, DATA_UV0 + texelSize * float2( 1,  1)) * 1.0;

	blur /= 16.0;

	// get original color
	float4 original = TEXTURE(tex_color, DATA_UV0);

	// increase sharpness
	float4 diff = original - blur;
	float4 result = original + diff * var_sharpness;

	OUT_COLOR = saturate(result) * DATA_VERTEX_COLOR;

	MAIN_FRAG_END 
#endif

	#}

	Pass post
	{
		Fragment = shader
		Vertex = shader
	}
}